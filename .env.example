# === server/.env ===
NODE_ENV=development
PORT=5000
DB_URI=mongodb://localhost:27017/arabicwordroot
JWT_SECRET=replace_with_64_random_hex_chars_min_32
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@arabicwordroot.local
SEED_ADMIN_PASSWORD=ChangeMeStrong!2026

# === client/.env (préfixe VITE_ obligatoire, valeurs PUBLIQUES) ===
VITE_API_URL=http://localhost:5000/api
VITE_DEFAULT_LANGUAGE=fr
