# =============================================================
# ArabicWordRoot — Backend env (S1 J1)
# Copier ce fichier en `server/.env` puis renseigner les valeurs.
# Toutes les variables ci-dessous sont validées par Joi (src/config/env.js).
# =============================================================

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute HTTP
PORT=5000

# Connection string MongoDB (Atlas ou local)
# Exemple Atlas : mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/arb?retryWrites=true&w=majority
DB_URI=mongodb://127.0.0.1:27017/arb-dev

# JWT — secret HMAC 32+ chars (générer : `openssl rand -base64 48`)
JWT_SECRET=change-me-please-use-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=24h

# bcrypt rounds (12 recommandé en prod)
BCRYPT_ROUNDS=12

# Front autorisé pour CORS (origin exact, sans slash final)
FRONTEND_URL=http://localhost:5173

# Seed admin (optionnel) — utilisé par `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Logs pino : fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Injecté par CI/CD (Render postdeploy) — visible dans /api/health
GIT_SHA=
