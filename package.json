{
  "name": "arabic-word-root",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo ArabicWordRoot - Apprentissage de l'arabe par les racines trilitères",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "seed:demo": "npm run seed:demo -w server",
    "validate:dataset": "npm run validate:dataset -w server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "puppeteer": "^24.43.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "prettier --write",
    "*.{json,md,yml}": "prettier --write"
  },
  "engines": {
    "node": ">=20"
  }
}
